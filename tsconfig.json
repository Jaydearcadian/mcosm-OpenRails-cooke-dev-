{
  "compilerOptions": {
    "target": "es2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "outDir": "dist",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["hardhat.config.ts", "server/**/*.ts", "test/**/*.ts"],
  "exclude": ["node_modules"]
}
