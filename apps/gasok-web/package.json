{
  "name": "openrails-gasok-web",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "predev": "npm run build:kernel",
    "dev": "concurrently -k -n api,web \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "OPENRAILS_GASOK_PORT=4174 node server/index.mjs --api-only",
    "build:kernel": "npm --prefix ../../agent-kernel run build",
    "build": "npm run build:kernel && tsc -b && vite build",
    "prestart": "npm run build:kernel",
    "start": "node server/index.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@openrails/design-system": "file:../../packages/openrails-design-system",
    "@vitejs/plugin-react": "^4.3.1",
    "framer-motion": "^11.3.19",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.1",
    "viem": "^2.53.1",
    "vite": "^5.4.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^8.2.2",
    "typescript": "^5.5.4"
  }
}
