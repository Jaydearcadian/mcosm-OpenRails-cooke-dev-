# OpenRails Cockpit — environment variables
# Copy to .env.local and fill in values.

# WalletConnect project ID (get one free at cloud.walletconnect.com)
# Required for WalletConnect support in RainbowKit. Defaults to "openrails-demo" (limited).
VITE_WALLETCONNECT_PROJECT_ID=

# Privy app ID (get one at privy.io)
# Required for "Sign in with Google" embedded wallet support.
# If not set, only injected wallets (MetaMask etc.) are available via RainbowKit.
VITE_PRIVY_APP_ID=

# Optional: override the API base URL (default: same-origin, proxied by Vite dev server)
# VITE_OPENRAILS_API_BASE=http://localhost:3001
